# Copy to .env and replace the empty secret with a unique random value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LEADORA_SECRET=
LEADORA_ENV=production
PORT=8000
LEADORA_WORKER_ENABLED=1
LEADORA_WORKER_POLL_SECONDS=15
LEADORA_SOURCE_MIN_INTERVAL_SECONDS=900

# Optional emergency recovery for a wrongly assigned platform owner.
# Configure only during an authorized recovery; use a unique token distinct from the bootstrap token.
# LEADORA_OWNER_RECOVERY_TOKEN must be at least 32 characters.
# LEADORA_OWNER_RECOVERY_EMAIL must exactly match the intended owner's account email.
LEADORA_OWNER_RECOVERY_TOKEN=
LEADORA_OWNER_RECOVERY_EMAIL=
