# Copy to .env and configure one unique installation per customer.
# Never reuse LEADORA_INSTANCE_ID, LEADORA_SECRET, or the customer data volume.
LEADORA_INSTANCE_ID=customer-example-7f3a9c2d
LEADORA_CUSTOMER_REF=customer-contract-example
LEADORA_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
LEADORA_LICENSE_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY
LEADORA_LICENSE_GRACE_DAYS=14
HOST_BIND=127.0.0.1
HOST_PORT=8000

# SECURITY: do not add LEADORA_LICENSE_PRIVATE_KEY to this file.
# The license-signing private key belongs only to the isolated owner control plane.
